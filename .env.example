# Copy to .env (gitignored) and adjust. docker compose and bin/ scripts read it.

# PHP version for the sandbox: any official wordpress:php<version>-apache tag.
PHP_VERSION=8.4

# Local port for the sandbox (http://localhost:<port>).
LAB_PORT=8083

# Which wp-content to mount: ./demo (bundled demo) or ./site (your site).
SITE_DIR=./demo

# Your site's table prefix, if it is not wp_.
TABLE_PREFIX=wp_

# WP Engine environment names, used by bin/pull-site.sh, bin/crawl-remote.sh
# and bin/deploy-wpengine.sh. Keep real names here, never in tracked files.
# WP Engine sites can have Development, Staging and Production environments.
WPE_PROD_ENV=
WPE_STAGING_ENV=
WPE_DEV_ENV=
# Production domain, for rewriting URLs when importing its database locally.
PROD_DOMAIN=
